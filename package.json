{
  "name": "alexiux-site",
  "version": "1.0.0",
  "description": "alexiux.com - static site with a custom Git-backed CMS",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "eleventy",
    "serve": "eleventy --serve --port=8080",
    "mirror": "python3 tools/mirror.py && python3 tools/postprocess.py",
    "verify": "python3 tools/verify.py"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0"
  }
}
